{
  "name": "masrouf-desktop",
  "productName": "Masrouf",
  "version": "1.4.0",
  "description": "مصروف — خطتي الشهرية",
  "author": "relifeg1",
  "license": "MIT",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never"
  },
  "devDependencies": {
    "electron": "^44.1.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "build": {
    "appId": "io.github.relifeg1.masrouf",
    "productName": "Masrouf",
    "copyright": "MIT · relifeg1",
    "files": [
      "main.js",
      "preload.js",
      "offline/**",
      "build/**"
    ],
    "directories": {
      "output": "out",
      "buildResources": "build"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "relifeg1",
        "repo": "masrouf"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Masrouf",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.finance"
    },
    "dmg": {
      "title": "مصروف"
    }
  }
}
