{
  "appId": "io.github.relifeg1.masrouf.beta",
  "productName": "Masrouf Beta",
  "copyright": "MIT · relifeg1",
  "files": [
    "main.js",
    "preload.js",
    "offline/**",
    "build/**"
  ],
  "directories": {
    "output": "out",
    "buildResources": "build"
  },
  "publish": [
    {
      "provider": "github",
      "owner": "relifeg1",
      "repo": "masrouf"
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ]
  },
  "nsis": {
    "artifactName": "Masrouf-Beta-Setup-${version}.${ext}",
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Masrouf Beta",
    "deleteAppDataOnUninstall": false
  },
  "mac": {
    "target": [
      {
        "target": "dmg",
        "arch": [
          "x64",
          "arm64"
        ]
      },
      {
        "target": "zip",
        "arch": [
          "x64",
          "arm64"
        ]
      }
    ],
    "category": "public.app-category.finance",
    "artifactName": "Masrouf-Beta-${version}-${arch}.${ext}"
  },
  "dmg": {
    "title": "مصروف",
    "artifactName": "Masrouf-Beta-${version}-${arch}.${ext}"
  },
  "extends": null,
  "extraMetadata": {
    "masroufChannel": "beta",
    "name": "masrouf-beta",
    "productName": "Masrouf Beta",
    "version": "1.5.0-beta.2"
  }
}
